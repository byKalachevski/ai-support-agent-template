APP_NAME=ai-support-agent-template
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8011
LOG_LEVEL=INFO

LLM_PROVIDER=generic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
LLM_JSON_MODE=true

KB_DIR=kb

RUNS_DIR=runs
LOGS_DIR=logs
CACHE_DIR=cache
SESSION_TTL_SECONDS=300

WORKER_ENABLED=false
WORKER_NAME=ai-support-agent-worker-1
WORKER_WS_URL=
WORKER_WS_PATH=/internal/support-agent/ws
WORKER_RECONNECT_DELAY_SECONDS=3
WORKER_MAX_RECONNECT_DELAY_SECONDS=30
WORKER_WS_PING_INTERVAL_SECONDS=20
WORKER_WS_PING_TIMEOUT_SECONDS=20

BACKEND_API_BASE_URL=
BACKEND_API_TOKEN=
CLAIM_JOB_PATH=/internal/support-agent/jobs/claim
COMPLETE_JOB_PATH=/internal/support-agent/jobs/{job_id}/complete
FAIL_JOB_PATH=/internal/support-agent/jobs/{job_id}/fail
HEARTBEAT_JOB_PATH=/internal/support-agent/jobs/{job_id}/heartbeat